<Window x:Class="MultitrackRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MultitrackRecorder.ViewModels"
        xmlns:models="clr-namespace:MultitrackRecorder.Models"
        mc:Ignorable="d"
        Title="8-Track Digital Recorder" Height="780" Width="1300" Background="#202225">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Play All" Command="{Binding PlayAllCommand}" Margin="0,0,8,0" Padding="18,8"/>
            <Button Content="Record All" Command="{Binding RecordAllCommand}" Margin="0,0,8,0" Padding="18,8"/>
            <Button Content="Mute All" Command="{Binding MuteAllCommand}" Padding="18,8"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1C1F24" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Track" Foreground="#B8BDC7" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Play" Foreground="#B8BDC7" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="Record" Foreground="#B8BDC7" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="Input / Cassette" Foreground="#B8BDC7" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="Output" Foreground="#B8BDC7" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="5" Text="Channel" Foreground="#B8BDC7" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="6" Text="Volume" Foreground="#B8BDC7" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="7" Text="Tone" Foreground="#B8BDC7" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="8" Text="Mute" Foreground="#B8BDC7" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tracks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TrackViewModel}">
                        <Border Background="#2A2D31" CornerRadius="6" Margin="0,0,0,10" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" Content="Play" IsChecked="{Binding PlayEnabled}" Foreground="White" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="2" Content="Record" IsChecked="{Binding RecordEnabled}" Foreground="White" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="3" Margin="4,0">
                                    <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}" DisplayMemberPath="Name" IsEnabled="{Binding IsInputSelectable}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Content="Load Tape" Command="{Binding LoadTapeCommand}" Padding="8,2" Margin="0,0,6,0"/>
                                        <Button Content="Eject" Command="{Binding EjectTapeCommand}" Padding="8,2"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TapeDisplayName}" Foreground="#C7CDD9" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="4" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Name" Margin="4,0"/>

                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <RadioButton Content="Mono" Foreground="White" IsChecked="True" Margin="2" Tag="{x:Static models:TrackChannelMode.Mono}" Checked="ChannelMode_Checked"/>
                                    <RadioButton Content="L" Foreground="White" Margin="2" Tag="{x:Static models:TrackChannelMode.LeftOnly}" Checked="ChannelMode_Checked"/>
                                    <RadioButton Content="R" Foreground="White" Margin="2" Tag="{x:Static models:TrackChannelMode.RightOnly}" Checked="ChannelMode_Checked"/>
                                </StackPanel>

                                <Slider Grid.Column="6" Minimum="0" Maximum="1" Value="{Binding Volume}" Margin="8,0"/>
                                <StackPanel Grid.Column="7" Orientation="Vertical">
                                    <Slider Minimum="-12" Maximum="12" Value="{Binding Bass}" ToolTip="Bass" Margin="8,0"/>
                                    <Slider Minimum="-12" Maximum="12" Value="{Binding Treble}" ToolTip="Treble" Margin="8,4,8,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="8" Content="Mute" ToolTip="Silences this track in the mix" IsChecked="{Binding Mute}" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Background="#171A1E" CornerRadius="6" Padding="10,8" BorderBrush="#3E4653" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📼" FontSize="18" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding RecordingTapeStatus}" Foreground="#E5E8EF" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
